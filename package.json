{
	"name": "mixxx-traktor-s5-mapping",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"check": "tsc",
		"dev": "vite build --watch",
		"build": "tsc && vite build",
		"test": "vitest",
		"test:run": "vitest run",
		"test:watch": "vitest watch",
		"test:mixxx-smoke": "node tests/mixxx-smoke/run-mixxx-smoke.mjs",
		"start": "mixxx --controller-debug --developer",
		"pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\""
	},
	"devDependencies": {
		"@types/node": "24.5.2",
		"vitest": "4.1.4",
		"vite": "7.3.1",
		"vite-plugin-dts": "4.5.4",
		"vite-plugin-static-copy": "3.2.0"
	}
}
