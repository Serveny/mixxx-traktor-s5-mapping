{
	"compilerOptions": {
		"target": "es6",
		"types": [], // Mapping code runs in Mixxx's QJSEngine, so no Node globals. Vitest brings its own types.
		"useDefineForClassFields": false,
		"lib": [
			"ES2016", // ES2016 is what Qt's QJSEngine supports.
		],
		"skipLibCheck": true,
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": false,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"declaration": true,
	},
	"include": [
		"src",
		"tests",
		// Mixxx controller API types (engine, script, controller, MixxxControls) come
		// from a Mixxx main checkout next to this repo (see README). It has to be main: the typed control
		// names in mixxx-controls.d.ts are not part of the Mixxx 2.5 release.
		"../mixxx/res/controllers/engine-api.d.ts",
		"../mixxx/res/controllers/script-api.d.ts",
		"../mixxx/res/controllers/hid-controller-api.d.ts",
		"../mixxx/res/controllers/mixxx-controls.d.ts",
		"../mixxx/res/controllers/console-api.d.ts",
		// The same files seen from a git worktree in .worktrees/<name>/. tsc ignores the variant that does not exist.
		"../../../mixxx/res/controllers/engine-api.d.ts",
		"../../../mixxx/res/controllers/script-api.d.ts",
		"../../../mixxx/res/controllers/hid-controller-api.d.ts",
		"../../../mixxx/res/controllers/mixxx-controls.d.ts",
		"../../../mixxx/res/controllers/console-api.d.ts",
	],
}
